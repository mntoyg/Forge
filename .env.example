# Copy this file to .env and fill in real values. NEVER commit .env.
# FORGE_API_KEY is required - `forge debug` calls a provider and exits 3
# without one. Everything below it has a working default.

# --- AI provider -----------------------------------------------------------
# API key for the configured provider. Read from the environment only.
FORGE_API_KEY=

# Provider identifier. Currently only "openai" is planned for the MVP.
FORGE_PROVIDER=openai

# Model identifier passed to the provider adapter.
FORGE_MODEL=gpt-4o-mini

# Optional override for self-hosted or proxy endpoints.
FORGE_BASE_URL=

# --- Behaviour -------------------------------------------------------------
# Log level: TRACE | DEBUG | INFO | SUCCESS | WARNING | ERROR | CRITICAL
FORGE_LOG_LEVEL=INFO

# Request timeout in seconds for outbound provider calls.
FORGE_TIMEOUT_SECONDS=60

# Largest source file Forge will analyse, in bytes. Files above this are
# refused rather than truncated: analysing half a file produces confident
# nonsense about the half it did not see.
FORGE_MAX_FILE_BYTES=200000
